<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>WasmGate.Control.Api</RootNamespace>
    <AssemblyName>wasmgate-control</AssemblyName>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WasmGate.Control.Core\WasmGate.Control.Core.csproj" />
    <ProjectReference Include="..\WasmGate.Control.Infrastructure\WasmGate.Control.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\agent_control.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
