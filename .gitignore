# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Profiling / benchmarks
*.prof
cpu.out
mem.out
old.txt
new.txt

# Local env / secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Obsidian vault config (docs are Markdown, config is not source)
.obsidian/

# IDE / editors
.idea/
.vscode/
*.swp
*~

# OS noise
.DS_Store
Thumbs.db
desktop.ini
.golangci.bck.yml

# Local compose demo certificates (generated by deployments/scripts/dev-certs.sh)
deployments/certs/

# Control-plane runtime data created when it is started from the repo root
# (default data/ca paths hold generated CA keys).
/data/

# Observability secrets and local env
deployments/observability/secrets/*
!deployments/observability/secrets/.gitkeep

# Local working material: never part of the product documentation
local/
