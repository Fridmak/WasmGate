[Unit]
Description=WasmGate TCP/L4 proxy with WebAssembly plugins
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wasmgate
Group=wasmgate
WorkingDirectory=/etc/wasmgate
ExecStart=/usr/local/bin/wasmgate -config /etc/wasmgate/wasmgate.yaml -shutdown-grace 30s
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576

# Bind low ports without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Filesystem and process hardening. Read-only access to /etc/wasmgate is enough:
# config, plugins and certificates are loaded at startup and on reload.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

# MemoryDenyWriteExecute намеренно не включён. JIT wazero создаёт исполняемые
# отображения памяти; перед включением директивы проверьте совместимость на
# своей версии wazero и ядре под нагрузкой.

[Install]
WantedBy=multi-user.target
