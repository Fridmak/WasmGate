# Copy to .env and source it before running ./run-fleet.sh.
# Do not commit this file: it contains a registration token.
CP_URL=https://control-plane:9096
CP_SERVER_CRT=deployments/certs/server.crt
RELEASE_PUB_KEY=/absolute/path/to/release-signing.key.pub
ENROLL_TOKEN=replace-with-a-registration-token
CONFIG_FILE=deployments/scenarios/05-dp-fleet/wasmgate.yaml

COUNT=20
NAME_PREFIX=edge
DP_IMAGE=wasmgate-dp
NETWORK=wasmgate-control_default
LABELS=role=edge
VOLUME_PREFIX=wasmgate-dp
