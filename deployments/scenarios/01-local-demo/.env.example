# Copy to .env.
# Generate the admin tokens with: openssl rand -hex 24
WASMGATE_CP_ADMIN_TOKEN=replace-with-a-random-secret
WASMGATE_ADMIN_TOKEN=replace-with-a-random-admin-token

# Optional: version reported by wasmgate_build_info in the demo image.
WASMGATE_DP_VERSION=dev

# Fill these after creating an agent in the UI.
WASMGATE_AGENT_ID=
WASMGATE_ENROLL_TOKEN=
