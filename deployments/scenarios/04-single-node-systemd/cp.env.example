# Copy to /etc/wasmgate-control/cp.env and edit.
# This file contains secrets: chmod 0640 root:wasmgate.

# SQLite is the control-plane store for a single-node installation.
WASMGATE_CP_SQLITE_PATH=/var/lib/wasmgate-control/data/control.db

WASMGATE_CP_GRPC_LISTEN=https://127.0.0.1:9096
WASMGATE_CP_HTTP_LISTEN=http://127.0.0.1:9097

WASMGATE_CP_ARTIFACT_ROOT=/var/lib/wasmgate-control/data/artifacts
WASMGATE_CP_AGENT_CA_CERT=/var/lib/wasmgate-control/data/ca/agents-ca.crt
WASMGATE_CP_AGENT_CA_KEY=/var/lib/wasmgate-control/data/ca/agents-ca.key
WASMGATE_CP_SIGNING_KEY=/var/lib/wasmgate-control/data/keys/release-signing.key
WASMGATE_CP_WASMGATE_BIN=/usr/local/bin/wasmgate

WASMGATE_CP_GRPC_TLS_CERT=/etc/wasmgate-control/tls/server.crt
WASMGATE_CP_GRPC_TLS_KEY=/etc/wasmgate-control/tls/server.key
WASMGATE_CP_GRPC_CLIENT_CA=/var/lib/wasmgate-control/data/ca/agents-ca.crt

# Generate with: openssl rand -hex 24
WASMGATE_CP_ADMIN_TOKEN=change-me
